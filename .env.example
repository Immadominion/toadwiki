# toad-wiki environment
#
# Copy to .env and fill in. .env is gitignored and MUST stay that way.
#
#   cp .env.example .env
#   set -a && . ./.env && set +a
#   python3 scripts/collect/transfers.py && python3 scripts/build_model.py
#
# ---------------------------------------------------------------------------
# SERVER-SIDE / BUILD-TIME ONLY. NONE OF THESE ARE PUBLIC.
# ---------------------------------------------------------------------------
# Everything here is read by python in scripts/ at build time. Nothing in this
# file may ever be exposed to the browser:
#
#   * Do NOT prefix any of these with NEXT_PUBLIC_. Next.js inlines every
#     NEXT_PUBLIC_* variable into the client bundle in plaintext -- that is a
#     one-line way to publish a paid API key to every visitor.
#   * Do NOT call these endpoints from a client component. The site ships as a
#     static build with the data already baked into data/model.json; the only
#     runtime fetch is DexScreener's keyless public price endpoint.
#   * Do NOT log or echo these values. See the note on HELIUS_RPC below.
# ---------------------------------------------------------------------------

# Solana mainnet JSON-RPC. A full-history archival endpoint is required: the
# collectors paginate the campaign ATA's signatures back to the launch block,
# and a pruned node silently returns a short list instead of an error.
#
# !! ON THIS ENDPOINT THE API KEY IS THE SUBDOMAIN. There is no ?api-key= query
# !! parameter to strip, so the bare HOSTNAME is by itself a working credential.
# !! Never write this hostname into a JSON artifact, a log line, a commit, or an
# !! error message. Scripts reduce it to "helius-rpc.com (keyed endpoint,
# !! subdomain redacted)" before recording provenance. Keep it that way -- a
# !! collector that logs "connected to <host>" republishes the key.
#
# Both Helius URL shapes work and both are secrets:
#     https://<key>.helius-rpc.com                  <- key in the subdomain
#     https://mainnet.helius-rpc.com/?api-key=<key> <- key in the query
#
# If unset, scripts fall back to https://api.mainnet-beta.solana.com, which
# works but is slow, rate-limits hard, and rejects batched calls.
HELIUS_RPC=https://REPLACE_ME.helius-rpc.com

# X (Twitter) API v2 bearer token. Used ONLY for enumeration -- walking
# timelines, full-archive $TOAD search, and per-day post counts.
#
# It is NOT needed for impressions: api.fxtwitter.com returns `views` keylessly,
# so every metric the site renders refreshes for free. If you have no token, the
# social collector degrades cleanly (status:"refused" with a reason) and exits 0.
# It never fabricates rows -- an empty search result means "unsearched", not
# "nothing was posted".
#
# A 401 on the free /2/users/by/username lookup means the token is revoked or
# regenerated, NOT that a spend cap was hit (a cap returns 403 on metered
# endpoints only). Fix it in the Developer Portal under Keys and tokens ->
# Bearer Token; raising the spend cap will not help.
X_BEARER_TOKEN=

# Never put the X billing account_id or project_id in this repo, in an
# artifact, or in any output. They are not needed to make an API call.
